---
import Base from '../layouts/Base.astro';
---

<Base title="About - openEarthModelling">
  <main class="mx-auto max-w-[720px] px-6 pt-32 pb-16">
    <h1 class="text-3xl font-semibold tracking-tight">About</h1>
    <p class="mt-4 text-base leading-relaxed" style="color: var(--text-dim);">
      openEarthModelling is an open research group building computational software
      for the Earth system. Everyone is welcome to contribute.
    </p>
  </main>
</Base>
